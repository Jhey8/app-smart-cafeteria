{
  "expo": {
    "name": "UTP Smart Cafetería",
    "slug": "utp-smart-cafeteria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0b5fd0"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para que elijas tu foto de perfil.",
          "cameraPermission": "La app usa la cámara para que te tomes tu foto de perfil."
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "utpcafeteria"
  }
}
